  </model>

  <!-- Second block (right one) -->
  <model name="obstacle_wp1">
    <static>true</static>
    <link name="obstacle_wp1">
      <collision name="collision">
        <geometry>
          <box><size>0.5 0.2 0.5</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>0.5 0.2 0.5</size></box>
        </geometry>
